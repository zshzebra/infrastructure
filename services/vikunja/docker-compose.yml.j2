services:
  vikunja:
    # PR go-vikunja/vikunja#2939, built from zshzebra/vikunja@finish-subprojects.
    # Digest-pinned: the deploy role runs `pull: always`.
    image: ghcr.io/zshzebra/vikunja:sha-13b0f4f4e685504bf81b5424255a8a0b7238df2f@sha256:8b69c3683039834081490d33bc3943c4fe5a05d9ebf8c2d0d3bfc880b946372d
    container_name: vikunja
    restart: unless-stopped
    environment:
      VIKUNJA_SERVICE_PUBLICURL: "https://{{ tunnel_hostnames['vikunja'] }}/"
      VIKUNJA_SERVICE_SECRET: "{{ vikunja_service_secret }}"
      VIKUNJA_DATABASE_PATH: /db/vikunja.db
    volumes:
      - ./files:/app/vikunja/files
      - ./db:/db
      - ./config.yml:/etc/vikunja/config.yml
    networks:
      - vikunja-network
    healthcheck:
      # Distroless image: no shell, so use vikunja's own healthcheck subcommand.
      test: ["CMD", "/app/vikunja/vikunja", "healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  tunnel:
    image: cloudflare/cloudflared:latest
    container_name: vikunja-tunnel
    restart: unless-stopped
    command: tunnel run
    environment:
      - TUNNEL_TOKEN={{ tunnel_token }}
    networks:
      - vikunja-network

networks:
  vikunja-network:
    driver: bridge
